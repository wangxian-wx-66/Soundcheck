# 试麦员 Soundcheck 环境变量模板
# 复制为 .env（本地）或由平台 Secret 注入（Sealos）；.env 已被 .gitignore 排除，切勿提交真实值
# 注意：本项目代码不读取 .env 文件（避免隐式加载），本地开发用 PowerShell 设置用户级环境变量：
#   [Environment]::SetEnvironmentVariable('DEEPSEEK_API_KEY','<你的key>','User')
#   [Environment]::SetEnvironmentVariable('ZHIHU_ACCESS_SECRET','<你的secret>','User')

# LLM 大脑（DeepSeek，OpenAI 兼容）
DEEPSEEK_API_KEY=
# 可选覆盖（默认 https://api.deepseek.com / deepseek-flash）
# LLM_BASE_URL=
# LLM_MODEL=

# 知乎开放平台数据接口（Bearer 鉴权）
ZHIHU_ACCESS_SECRET=

# 知乎 OAuth（App Key 属于用户级环境变量，不入库）
# ZHIHU_OAUTH_APP_KEY=

# 冒烟测试（mock LLM / mock 知乎接口，零额度消耗）
# LLM_MOCK=1
# SMOKE=1
