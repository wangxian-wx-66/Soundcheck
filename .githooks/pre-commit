#!/usr/bin/env node
// pre-commit 密钥扫描（零依赖，替代 detect-secrets/trufflehog 的轻量实现）
// 扫描暂存区新增/修改行中的高危凭证模式；命中则阻断提交并给出文件定位
// 启用：git config core.hooksPath .githooks（一次性，仓库内生效）
import { execFileSync } from 'node:child_process';

const PATTERNS = [
  { name: 'API key / secret 赋值', re: /(api[_-]?key|access[_-]?secret|app[_-]?key|secret|token|password)\s*[:=]\s*['"][A-Za-z0-9+/_-]{16,}['"]/i },
  { name: 'Bearer 长凭证', re: /Bearer\s+[A-Za-z0-9+/_-]{24,}/ },
  { name: '私钥块', re: /-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----/ },
  { name: '知乎 Access Secret 形态', re: /['"][A-Za-z0-9]{32,}['"].*(secret|SECRET)/ },
];

let staged;
try {
  staged = execFileSync('git', ['diff', '--cached', '--name-only', '--diff-filter=ACM'], { encoding: 'utf8' })
    .split('\n').map((s) => s.trim()).filter(Boolean);
} catch (error) {
  console.error(`pre-commit: 无法读取暂存区（${error.message}）`);
  process.exit(1);
}

if (!staged.length) process.exit(0); // 无暂存变更（如 --allow-empty）

const findings = [];
for (const file of staged) {
  let diff;
  try {
    diff = execFileSync('git', ['diff', '--cached', '-U0', '--', file], { encoding: 'utf8' });
  } catch { continue; }
  const addedLines = diff.split('\n').filter((line) => line.startsWith('+') && !line.startsWith('+++'));
  addedLines.forEach((line, index) => {
    for (const { name, re } of PATTERNS) {
      if (re.test(line)) findings.push({ file, name, sample: line.slice(1, 120).replace(/[A-Za-z0-9+/_-]{20,}/g, '***') });
    }
  });
}

if (findings.length) {
  console.error('pre-commit: 检测到疑似密钥/凭证，提交已阻断：\n');
  for (const f of findings) console.error(`  ${f.file} · ${f.name}\n    ${f.sample}\n`);
  console.error('处理方式：密钥一律走环境变量（.env.example 见模板）；若为误报，用 git commit --no-verify 跳过并注明原因。');
  process.exit(1);
}
process.exit(0);
